{
  "main": "./dist/backend/index.js",
  "type": "module",
  "dependencies": {
    "chess.js": "^1.4.0",
    "http-server": "^14.1.1",
    "pgn-parser": "^2.2.1",
    "ws": "^8.21.2"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:pages": "node scripts/buildStatic.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "serve": "node ./dist/backend/index.js localhost 8080",
    "serve:pages": "npx http-server dist-pages -p 8081 -c-1",
    "typecheck": "tsc --noEmit",
    "wab": "wasm-pack build --target web"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
